# systemd unit for Linux hosts. Install:
#   sudo cp deploy/claude-rotate.service /etc/systemd/system/
#   sudo systemctl enable --now claude-rotate
[Unit]
Description=claude-rotate — Claude subscription rotating proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOU
WorkingDirectory=/home/YOU/claude-rotate
ExecStart=/usr/bin/python3 /home/YOU/claude-rotate/rotator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
